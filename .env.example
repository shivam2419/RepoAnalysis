# Groq-compatible chat API settings. Put your real key only in the private .env file.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_ENDPOINT=https://api.groq.com/openai/v1

# Embeddings run locally; the model downloads the first time the API indexes a repository.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
# Local Streamlit-to-FastAPI connection.
API_BASE_URL=http://127.0.0.1:8000

# Limits that prevent unexpectedly large repository ingestion jobs.
MAX_REPO_FILE_COUNT=2000
MAX_REPO_BYTES=157286400
MAX_FILE_BYTES=262144

# Chunk overlap preserves context near boundaries; top-k controls retrieved excerpts.
CHUNK_SIZE_LINES=200
CHUNK_OVERLAP_LINES=40
TOP_K_RESULTS=5

# Keep chat requests within low Groq token-per-minute limits.
MAX_CONTEXT_CHARS=1400
MAX_COMPLETION_TOKENS=160
